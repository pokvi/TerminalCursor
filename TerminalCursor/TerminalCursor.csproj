<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <AssemblyName>TerminalCursor</AssemblyName>
        <Description>TerminalCursor mod</Description>
        <Version>1.1.0</Version>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <!-- Реальные пути к игре на этой машине (см. PATHS.txt) -->
        <GameDir>D:\steam\steamapps\common\Lethal Company</GameDir>
        <ManagedDir>$(GameDir)\Lethal Company_Data\Managed</ManagedDir>
        <MMHOOKDir>$(GameDir)\BepInEx\plugins\MMHOOK</MMHOOKDir>
        <PluginDir>$(GameDir)\BepInEx\plugins\TerminalCursor</PluginDir>
        <!-- Корень репозитория. $(SolutionDir) не задана при сборке одного csproj,
             поэтому считаем путь от самого файла проекта. -->
        <RepoDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</RepoDir>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
        <PackageReference Include="BepInEx.Core" Version="5.*" />
        <PackageReference Include="BepInEx.PluginInfoProps" Version="1.*" />
        <PackageReference Include="UnityEngine.Modules" Version="2022.3.9" IncludeAssets="compile" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
    </ItemGroup>

    <!-- Игровые DLL (только то, что реально нужно Plugin.cs) -->
    <ItemGroup>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="MMHOOK_Assembly-CSharp">
            <HintPath>$(MMHOOKDir)\MMHOOK_Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.Netcode.Runtime">
            <HintPath>$(ManagedDir)\Unity.Netcode.Runtime.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.Netcode.Components">
            <HintPath>$(ManagedDir)\Unity.Netcode.Components.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.Networking.Transport">
            <HintPath>$(ManagedDir)\Unity.Networking.Transport.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.InputSystem">
            <HintPath>$(ManagedDir)\Unity.InputSystem.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Facepunch.Steamworks.Win64">
            <HintPath>$(ManagedDir)\Facepunch.Steamworks.Win64.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <!-- TextMeshPro (типы TMPro.*) и UI (TMP_InputField живёт в Unity.TextMeshPro,
             Scrollbar/RectMask2D - в UnityEngine.UI) -->
        <Reference Include="Unity.TextMeshPro">
            <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.UI">
            <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- PostBuild: копируем dll в папку плагинов игры и в publish -->
    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <Exec Condition="Exists('$(PluginDir)')"
              Command="copy /Y &quot;$(TargetDir)$(ProjectName).dll&quot; &quot;$(PluginDir)\$(ProjectName).dll&quot;" />
        <Exec Condition="Exists('$(RepoDir)publish')"
              Command="copy /Y &quot;$(TargetDir)$(ProjectName).dll&quot; &quot;$(RepoDir)publish\$(ProjectName).dll&quot;" />
        <Exec Condition="Exists('$(RepoDir)README.md')"
              Command="copy /Y &quot;$(RepoDir)README.md&quot; &quot;$(RepoDir)publish\README.md&quot;" />
    </Target>

</Project>
